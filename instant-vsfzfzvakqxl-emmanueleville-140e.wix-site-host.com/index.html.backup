<script>
(function(){
  var d=document,de=d.documentElement,$=function(q,c){return (c||d).querySelector(q)},$$=function(q,c){return [].slice.call((c||d).querySelectorAll(q))};
  de.classList.add('js');
  var h=$('#hero'),nav=$('.nav'),pg=$('#pg'),wrap=$('.hero .wrap');
  h.addEventListener('pointermove',function(e){var r=h.getBoundingClientRect();h.style.setProperty('--x',(e.clientX-r.left)+'px');h.style.setProperty('--y',(e.clientY-r.top)+'px')});
  /* scroll: progress bar, solid nav, hero parallax */
  function onScroll(){var y=scrollY,m=de.scrollHeight-innerHeight;pg.style.transform='scaleX('+(m>0?y/m:0)+')';nav.classList.toggle('solid',y>40);
    if(y<innerHeight){wrap.style.transform='translateY('+y*.25+'px)';wrap.style.opacity=Math.max(0,1-y/(innerHeight*.8))}}
  addEventListener('scroll',onScroll,{passive:true});onScroll();
  /* rotating headline */
  var words=['Stand out.','Be seen.','Be trusted.','Be remembered.'],wi=0,rot=$('#rot');
  setInterval(function(){rot.classList.add('out');setTimeout(function(){wi=(wi+1)%words.length;rot.textContent=words[wi];rot.classList.remove('out')},350)},2800);
  /* scroll reveal with stagger */
  $$('section h2,.lead p,.stats div,.services .sub,.filters,.card,.tags,.detail,.contact .box').forEach(function(el,i){el.classList.add('rv');
    var sib=el.parentNode.children;el.style.setProperty('--d',(Math.min([].indexOf.call(sib,el),8)*.07)+'s')});
  var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target)}})},{threshold:.12});
  $$('.rv').forEach(function(el){io.observe(el)});
  /* active nav link */
  var links=$$('.nav nav a:not(.btn)');
  var so=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)links.forEach(function(a){a.classList.toggle('on',a.getAttribute('href')==='#'+e.target.id)})})},{rootMargin:'-45% 0px -50% 0px'});
  ['about','services','brands','results','clients'].forEach(function(id){so.observe(d.getElementById(id))});
  /* service filters + card spotlight */
  var cat={'Event management':'ev','Experiential':'ev','PR strategy':'pr','Media coverage':'pr','Photo':'cr','Branding':'cr','Content':'cr','Talent':'ta'};
  $$('.card').forEach(function(c){var t=$('h3',c).textContent;for(var k in cat)if(t.indexOf(k)===0)c.dataset.c=cat[k];
    c.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect();c.style.setProperty('--mx',(e.clientX-r.left)+'px');c.style.setProperty('--my',(e.clientY-r.top)+'px')})});
  $$('.filters button').forEach(function(b){b.addEventListener('click',function(){
    $$('.filters button').forEach(function(x){x.classList.toggle('on',x===b)});
    $$('.card').forEach(function(c){var show=b.dataset.f==='all'||c.dataset.c===b.dataset.f;c.classList.toggle('gone',!show);
      c.classList.remove('pop');if(show){void c.offsetWidth;c.classList.add('pop','in')}})})});
  /* who we serve */
  var info={'Executives':'Thought-leadership positioning, media training and press moments that build executive credibility.',
  'Public figures':'Reputation management, public appearances and coverage that keep your narrative in your hands.',
  'Corporate brands':'Launches, conferences and brand campaigns delivered with polished media and clear messaging.',
  'Fashion labels':'Runway shows, lookbook shoots, influencer moments and press that give collections their spotlight.',
  'Entertainment projects':'Premieres, talent, publicity and event coverage that turn releases into conversations.',
  'Lifestyle brands':'Activations and storytelling that make your brand part of your audience’s everyday life.',
  'Institutions':'Public communication, summits and visual documentation that build trust with stakeholders.',
  'Growing businesses':'Visibility on a plan: PR, content and events that bring in customers and sales.'};
  var det=$('#detail');
  function show(t){det.classList.add('sw');setTimeout(function(){det.innerHTML='<b>'+t+'</b>'+info[t];det.classList.remove('sw')},220)}
  $$('.tags button').forEach(function(b){b.addEventListener('click',function(){$$('.tags button').forEach(function(x){x.classList.toggle('on',x===b)});show(b.textContent)})});
  det.innerHTML='<b>Executives</b>'+info['Executives'];
  /* mobile menu */
  var bg=$('#bg');
  function menu(o){nav.classList.toggle('open',o);bg.setAttribute('aria-expanded',o);bg.setAttribute('aria-label',o?'Close menu':'Open menu');d.body.style.overflow=o?'hidden':''}
  bg.addEventListener('click',function(){menu(!nav.classList.contains('open'))});
  $$('.nav nav a').forEach(function(a){a.addEventListener('click',function(){menu(false)})});
  addEventListener('keydown',function(e){if(e.key==='Escape')menu(false)});
  h.addEventListener('pointerdown',function(e){var r=h.getBoundingClientRect();h.style.setProperty('--x',(e.clientX-r.left)+'px');h.style.setProperty('--y',(e.clientY-r.top)+'px')});
  /* brands marquee */
  var R1=[{"n":"Heineken","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"Goldberg Lager Beer","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"Johnnie Walker","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"Trophy","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"GTCO Food & Drinks","s":"data:image/jpeg;base64,","b":"#ffffff","r":true},{"n":"Oppo","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"1xBet","s":"data:image/jpeg;base64,","b":"#ffffff","r":false}],R2=[{"n":"GTCO Fashion Weekend","s":"data:image/jpeg;base64,","b":"#f5f8fd","r":false},{"n":"MO Organics","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"Development Bank of Nigeria","s":"data:image/jpeg;base64,","b":"#fefefe","r":false},{"n":"VFD Group","s":"data:image/jpeg;base64,","b":"#f9fefb","r":false},{"n":"Gadget Pimp","s":"data:image/jpeg;base64,","b":"#ffffff","r":false},{"n":"Dgreat Visuals","s":"data:image/jpeg;base64,","b":"#010101","r":false}];
  function fill(id,list,more){var h='';for(var k=0;k<2;k++){list.forEach(function(b){h+='<div class="tile logo"'+(k?' aria-hidden="true"':'')+' style="background:'+b.b+'" title="'+b.n.replace('&','&amp;')+'"><img src="'+b.s+'" alt="'+b.n.replace('&','&amp;')+' logo"'+(b.r?' class="rd"':'')+' decoding="async"></div>'});if(more)h+='<div class="tile more"'+(k?' aria-hidden="true"':'')+'>And many more</div>'}$('#'+id).innerHTML=h}
  fill('r1',R1);fill('r2',R2,true);
  /* count up */
  var cnt=$('#cnt'),done=false;
  new IntersectionObserver(function(es,o){if(es[0].isIntersecting&&!done){done=true;var t0=performance.now();(function f(t){var p=Math.min((t-t0)/1600,1);cnt.textContent=Math.round(150*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(f)})(t0);o.disconnect()}},{threshold:.4}).observe(cnt);
  /* testimonials */
  var PEOPLE=[['Mr. Akin Anifowose','GTCO Food & Drinks','GTCO Food & Drinks','Working with Dgreat Hub is always a pleasure, their professionalism is top notch and stress free, I look forward to working with them again and again, thank you for holding the forth.'],['Mrs. Christine Ugbeh','Johnnie Walker','Johnnie Walker','As always, pulling weights of a thousand people, thanks for making our stakeholders proud and happy, the success of our events is indeed a remarkable one, kudos to you and your team.'],['Mr. David Ajayi','1xBet Nigeria','1xBet','A professional team to ever grace our industry, love working with you guys, more to come.'],['Mr. Collins Timothy','GTCO Fashion Weekend','GTCO Fashion Weekend','How about we make it a habit of working every week! You guys are the best, I deeply appreciate you & your team. Lunch on me!'],['Mr. Olumide Akinoluwa','VFD Group','VFD Group','Grand execution on our listing on the NGX market, you delivered on every task, and I am still in shock on how your team pulled it off, thank you!'],['Mr. Emmanuel Ugonna','Heineken Nigeria','Heineken','The best team for the job, never in doubt when they are handling all our activations, working with your team is blissful, thanks always.']];
  var LG={};R1.concat(R2).forEach(function(b){LG[b.n]=b});
  $('.strack').innerHTML=PEOPLE.map(function(x){var l=LG[x[2]];return '<figure class="slide"><div class="who2"><span class="lg2" style="background:'+l.b+'"><img src="'+l.s+'" alt="'+x[1].replace('&','&amp;')+' logo"'+(l.r?' class="rd"':'')+'></span><div><cite>'+x[0]+'</cite><span>'+x[1].replace('&','&amp;')+'</span></div></div>'+(x[3]?'<p>“'+x[3].replace('&','&amp;')+'”</p>':'')+'</figure>'}).join('');
  var tr=$('.strack'),n=tr.children.length,ix=0,dots=$('#dots'),timer;
  for(var q=0;q<n;q++){var b=d.createElement('b');b.dataset.i=q;dots.appendChild(b)}
  function go(i){ix=(i+n)%n;[].forEach.call(tr.children,function(sl,k){sl.setAttribute('aria-hidden',k!==ix)});tr.style.transform='translateX(-'+ix*100+'%)';$$('b',dots).forEach(function(b,k){b.classList.toggle('on',k===ix)})}
  var calm=matchMedia('(prefers-reduced-motion:reduce)').matches;
  function auto(){clearInterval(timer);if(calm)return;timer=setInterval(function(){go(ix+1)},6000)}
  $('#nx').onclick=function(){go(ix+1);auto()};$('#pv').onclick=function(){go(ix-1);auto()};
  dots.onclick=function(e){if(e.target.dataset.i){go(+e.target.dataset.i);auto()}};
  var sx=null,sl=$('#sl');sl.addEventListener('touchstart',function(e){sx=e.touches[0].clientX},{passive:true});
  sl.addEventListener('touchend',function(e){if(sx!==null){var dx=e.changedTouches[0].clientX-sx;if(Math.abs(dx)>40){go(ix+(dx<0?1:-1));auto()}sx=null}});
  sl.addEventListener('mouseenter',function(){clearInterval(timer)});sl.addEventListener('mouseleave',auto);sl.addEventListener('focusin',function(){clearInterval(timer)});
  go(0);auto();
  /* contact form -> email */
  var fm=$('#f');fm.addEventListener('submit',function(e){e.preventDefault();var i=fm.querySelectorAll('input,textarea'),c=$$('#chips .on').map(function(b){return b.textContent}).join(', ');
    var body='Name: '+i[0].value+'\nEmail: '+i[1].value+'\nInterested in: '+(c||'Not specified')+'\n\n'+i[2].value;
    var a=d.createElement('a');a.href='mailto:dgreathubprmedia@gmail.com?subject='+encodeURIComponent('Enquiry from '+i[0].value)+'&body='+encodeURIComponent(body);d.body.appendChild(a);a.click();a.remove();
    var o=$('#ok');o.style.display='block';o.classList.add('show')});
  /* contact chips */
  $$('#chips button').forEach(function(b){b.addEventListener('click',function(){b.classList.toggle('on')})});
})();
</script>
