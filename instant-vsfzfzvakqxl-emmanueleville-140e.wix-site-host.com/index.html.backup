<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from https://instant-vsfzfzvakqxl-emmanueleville-140e.wix-site-host.com/ by HTTrack Website Copier/3.x [XR&CO], Sun, 04 Oct 2026 15:49:01 GMT -->
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="description" content="Dgreat Hub – PR & Media is a strategic communications and media company: PR, events, brand activations, media coverage and talent for brands that want to stand out.">
<meta name="theme-color" content="#1a0f2e">
<meta property="og:title" content="Dgreat Hub – PR & Media">
<meta property="og:description" content="Over 150 brands transformed. Strategy, creativity and excellence.">
<title>Dgreat Hub – PR & Media</title>
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@800&amp;family=Playfair+Display:wght@500&amp;family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&amp;family=DM+Sans:wght@400;500&amp;display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1a0f2e; --ink2:#241540; --paper:#faf6ef; --paper2:#f0e9dc;
  --gold:#f3b640; --rose:#ff5a7e; --text:#1a0f2e; --muted:#5e5470;
  --bg:var(--paper); --card:#fff; --line:rgba(26,15,46,.14);
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#150b26;--card:#21143b;--text:#f5efe6;--muted:#b6aac9;--line:rgba(255,255,255,.16);--paper2:#1d1133}}
:root[data-theme="dark"]{--bg:#150b26;--card:#21143b;--text:#f5efe6;--muted:#b6aac9;--line:rgba(255,255,255,.16);--paper2:#1d1133}
html{scroll-behavior:smooth;scroll-padding-top:calc(76px + env(safe-area-inset-top,0px))}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:400 17px/1.65 "DM Sans",system-ui,sans-serif}
h1,h2,h3{font-family:"Bricolage Grotesque",Georgia,sans-serif;line-height:1.05;margin:0;letter-spacing:-.02em}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.wrap{max-width:1160px;margin:0 auto;padding:0 24px}
header.nav{position:absolute;top:0;left:0;right:0;z-index:5;padding:calc(18px + env(safe-area-inset-top,0px)) 0 0}
.nav .wrap{display:flex;justify-content:space-between;align-items:center}
.logo{display:flex;align-items:center;gap:12px;color:#fff;text-decoration:none}
.logo svg{height:44px;width:auto;flex:none}
.lt{font:800 17px/1 Montserrat,sans-serif;letter-spacing:.01em;white-space:nowrap}
.lt b{color:var(--gold)}
.lt small{display:block;margin-top:6px;font:500 9px/1 "Playfair Display",Georgia,serif;letter-spacing:.42em;color:#e9e1f5}
.lg{fill:#8c8c8c}.lw{fill:#fff}
.nav nav{display:flex;gap:26px;align-items:center}
.nav nav a{color:#e9e1f5;text-decoration:none;font-size:15px}
.nav nav a:hover{color:#fff}
.btn{display:inline-block;padding:14px 26px;border-radius:999px;background:var(--gold);color:var(--ink)!important;font-weight:500;text-decoration:none;transition:transform .2s,background .2s}
.btn:hover{transform:translateY(-2px);background:#ffc85c}
.btn.ghost{background:transparent;color:#fff!important;border:1px solid rgba(255,255,255,.4)}
.btn.ghost:hover{background:rgba(255,255,255,.1)}

/* hero: a stage spotlight that follows the pointer */
.hero{position:relative;min-height:100vh;min-height:100svh;background:var(--ink);color:#fff;display:flex;align-items:center;overflow:hidden;--x:68%;--y:38%}
.hero::before{content:"";position:absolute;inset:0;background:radial-gradient(520px circle at var(--x) var(--y),rgba(243,182,64,.34),rgba(255,90,126,.16) 40%,transparent 70%)}
.hero::after{content:"";position:absolute;inset:0;background:radial-gradient(900px circle at 10% 110%,#3a1a66,transparent 60%);opacity:.7}
.hero .wrap{position:relative;z-index:2;padding-top:120px;padding-bottom:80px}
.hero h1{font-size:clamp(46px,9vw,118px);font-weight:800;max-width:12ch}
.hero h1 em{font-style:normal;color:var(--gold)}
.hero p{max-width:52ch;font-size:clamp(18px,2vw,21px);color:#d9cfe9;margin:28px 0 36px}
.hero .cta{display:flex;gap:14px;flex-wrap:wrap}
.hero h1,.hero p,.hero .cta{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}
.hero p{animation-delay:.15s}.hero .cta{animation-delay:.3s}
@keyframes rise{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}

.strip{background:var(--gold);color:var(--ink);padding:16px 0;overflow:hidden;white-space:nowrap}
.strip div{display:inline-block;font:600 18px "Bricolage Grotesque",sans-serif;animation:slide 38s linear infinite}
.strip span{margin:0 22px}
@keyframes slide{to{transform:translateX(-50%)}}

section{padding:110px 0}
.lead{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:start}
.lead h2{font-size:clamp(34px,5vw,60px)}
.lead p{color:var(--muted);margin:0 0 18px}
.lead p:first-child{color:var(--text);font-size:20px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:32px}
.stats div{border-top:2px solid var(--rose);padding-top:12px;font-weight:500;font-size:15px}

.services{background:var(--paper2)}
.services h2{font-size:clamp(34px,5vw,60px);max-width:16ch}
.services .sub{color:var(--muted);max-width:56ch;margin:18px 0 52px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.card{background:var(--card);border-radius:20px;padding:28px 24px;border:1px solid var(--line);transition:transform .25s,border-color .25s}
.card:hover{transform:translateY(-5px);border-color:var(--rose)}
.card svg{width:34px;height:34px;stroke:var(--rose);fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;margin-bottom:56px}
.card h3{font-size:21px;margin-bottom:10px}
.card p{margin:0;font-size:15px;color:var(--muted);line-height:1.55}
.card.wide{grid-column:span 2;background:var(--ink);color:#fff;border:0}
.card.wide p{color:#cfc3e3}.card.wide svg{stroke:var(--gold)}

.who{background:var(--ink);color:#fff}
.who h2{font-size:clamp(34px,5vw,60px);max-width:18ch;margin-bottom:48px}
.tags{display:flex;flex-wrap:wrap;gap:12px}

.contact .box{background:var(--ink);color:#fff;border-radius:32px;padding:clamp(36px,6vw,80px);display:grid;grid-template-columns:1.2fr 1fr;gap:48px;position:relative;overflow:hidden}
.contact .box::after{content:"";position:absolute;right:-120px;top:-120px;width:380px;height:380px;border-radius:50%;background:radial-gradient(circle,rgba(243,182,64,.4),transparent 70%)}
.contact h2{font-size:clamp(34px,5vw,64px)}
.contact p{color:#d9cfe9;max-width:42ch;margin:20px 0 0}
.contact form{position:relative;z-index:1;display:grid;gap:12px}
.contact label{font-size:14px;color:#cfc3e3}
.contact input,.contact textarea{width:100%;margin-top:4px;padding:13px 16px;border-radius:12px;border:1px solid rgba(255,255,255,.25);background:rgba(255,255,255,.07);color:#fff;font:inherit}
.contact input::placeholder,.contact textarea::placeholder{color:#9e90b8}
.contact button{border:0;cursor:pointer;font:500 17px "DM Sans",sans-serif;margin-top:6px}
.contact .ok{display:none;color:var(--gold);font-weight:500}

@media(max-width:960px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .lead,.contact .box{grid-template-columns:1fr;gap:32px}
  section{padding:80px 0}
}
@media(max-width:520px){.grid{grid-template-columns:1fr}.card.wide{grid-column:auto}.stats{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}html{scroll-behavior:auto}}

/* ---- live layer ---- */
.progress{position:fixed;top:0;left:0;height:3px;width:100%;transform-origin:0 50%;transform:scaleX(0);background:linear-gradient(90deg,var(--rose),var(--gold));z-index:20}
.nav{position:fixed!important;transition:background .3s,padding .3s}
.nav::before{content:"";position:absolute;inset:0;z-index:-1;background:rgba(26,15,46,.88);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);opacity:0;transition:opacity .3s}
.nav.solid{padding-bottom:14px}.nav.solid::before{opacity:1}
.nav nav a:not(.btn){position:relative}
.nav nav a:not(.btn)::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;background:var(--gold);transform:scaleX(0);transition:transform .3s}
.nav nav a.on::after,.nav nav a:not(.btn):hover::after{transform:scaleX(1)}
.blob{position:absolute;border-radius:50%;filter:blur(70px);opacity:.55;z-index:1;pointer-events:none}
.b1{width:420px;height:420px;background:#7a2cff;left:-120px;top:10%;animation:float 14s ease-in-out infinite}
.b2{width:360px;height:360px;background:var(--rose);right:-80px;bottom:5%;animation:float 11s ease-in-out infinite reverse}
@keyframes float{50%{transform:translate(60px,-50px) scale(1.15)}}
#rot{display:inline-block;transition:opacity .35s,transform .35s}
#rot.out{opacity:0;transform:translateY(-18px)}
.hint{position:absolute;bottom:26px;left:50%;z-index:2;width:26px;height:42px;border:2px solid rgba(255,255,255,.4);border-radius:14px;transform:translateX(-50%)}
.hint::after{content:"";position:absolute;left:50%;top:8px;width:4px;height:8px;margin-left:-2px;border-radius:2px;background:var(--gold);animation:wheel 1.6s infinite}
@keyframes wheel{to{transform:translateY(14px);opacity:0}}
.strip:hover div{animation-play-state:paused}
.js .rv{opacity:0;transform:translateY(34px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0s)}
.js .rv.in{opacity:1;transform:none}
.filters{display:flex;gap:10px;flex-wrap:wrap;margin:-20px 0 32px}
.filters button,.chips button{font:500 15px "DM Sans",sans-serif;padding:10px 20px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--text);cursor:pointer;transition:all .25s}
.filters button:hover{border-color:var(--rose)}
.filters button.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.card{position:relative;overflow:hidden}
.card::before{content:"";position:absolute;inset:0;background:radial-gradient(260px circle at var(--mx,50%) var(--my,50%),rgba(255,90,126,.16),transparent 65%);opacity:0;transition:opacity .3s;pointer-events:none}
.card:hover::before{opacity:1}
.card svg{transition:transform .4s}.card:hover svg{transform:translateY(-6px) rotate(-8deg) scale(1.1)}
.card.gone{display:none}
.card.pop{animation:pop .5s cubic-bezier(.2,.7,.2,1) both}
@keyframes pop{from{opacity:0;transform:scale(.92) translateY(14px)}}
.tags button{font:600 19px "Bricolage Grotesque",sans-serif;color:#fff;padding:13px 24px;border-radius:999px;border:1px solid rgba(255,255,255,.28);background:transparent;cursor:pointer;transition:all .25s}
.tags button:hover{transform:translateY(-3px);border-color:var(--gold)}
.tags button.on{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.detail{margin-top:36px;min-height:96px;padding:28px 32px;border-radius:20px;background:var(--ink2);border-left:4px solid var(--rose);max-width:760px;font-size:19px;color:#e6dcf5;transition:opacity .25s,transform .25s}
.detail.sw{opacity:0;transform:translateX(16px)}
.detail b{display:block;font:800 26px "Bricolage Grotesque",sans-serif;color:#fff;margin-bottom:6px}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:2px 0 4px}
.chips button{color:#e6dcf5;border-color:rgba(255,255,255,.28);padding:8px 16px;font-size:14px}
.chips button.on{background:var(--rose);border-color:var(--rose);color:#fff;transform:scale(1.05)}
.contact .ok.show{display:block;animation:pop .6s both}

/* ---- monochrome brand layer ---- */
.mark{position:absolute;z-index:1;right:6%;top:50%;width:min(40vw,480px);height:auto;opacity:.16;transform:translateY(-50%);animation:markf 9s ease-in-out infinite;pointer-events:none}
@keyframes markf{50%{transform:translateY(-54%) rotate(2deg)}}
.tags button:nth-child(3n+1){background:var(--rose);color:#fff;border-color:var(--rose)}
.tags button:nth-child(3n+2){background:var(--gold);color:var(--ink);border-color:var(--gold)}
.tags button.on{background:transparent;color:#fff;border-color:#fff;box-shadow:inset 0 0 0 1px #fff}
.chips button.on{background:var(--rose);color:#fff;border-color:var(--rose)}
.filters button.on{background:var(--text);color:var(--bg);border-color:var(--text)}
.contact .box{border:1px solid var(--line)}
.burger{display:none;width:46px;height:46px;border:0;background:none;cursor:pointer;flex-direction:column;justify-content:center;align-items:center;gap:7px;z-index:30;position:relative}
.burger i{display:block;width:26px;height:2px;background:#fff;transition:transform .3s,opacity .3s}
.nav.open .burger i:first-child{transform:translateY(4.5px) rotate(45deg)}
.nav.open .burger i:last-child{transform:translateY(-4.5px) rotate(-45deg)}
footer{background:var(--ink);color:#cfc3e3;font-size:15px;padding:64px 0 36px}
.fgrid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.16)}
.fgrid p{margin:18px 0 0;max-width:34ch}
.fgrid h4{margin:0 0 14px;font:600 16px "Bricolage Grotesque",sans-serif;color:#fff}
.fgrid a{display:block;color:#cfc3e3;text-decoration:none;padding:5px 0}.fgrid a:hover{color:#fff}
.fbase{padding-top:24px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:14px;color:#9e90b8}
@media(max-width:960px){
  .burger{display:flex}
  .nav nav{position:fixed;inset:0;flex-direction:column;justify-content:center;gap:10px;background:#1a0f2e;transform:translateY(-100%);visibility:hidden;transition:transform .45s cubic-bezier(.2,.7,.2,1),visibility .45s;padding:24px}
  .nav.open nav{transform:none;visibility:visible}
  .nav nav a:not(.btn){display:block;font:800 clamp(30px,8vw,44px) "Bricolage Grotesque",sans-serif;padding:8px 0}
  .nav nav a.btn{margin-top:18px}
  .mark{right:-12%;top:62%;width:78vw;opacity:.1}
  .fgrid{grid-template-columns:1fr 1fr}.fgrid>div:first-child{grid-column:1/-1}
}
@media(max-width:520px){
  body{font-size:16px}.wrap{padding:0 20px}
  .logo svg{height:38px}.lt{font-size:15px}
  .hero .wrap{padding-top:110px}.hero .cta .btn{width:100%;text-align:center}
  .hint{display:none}
  .filters{flex-wrap:nowrap;overflow-x:auto;margin-right:-20px;padding-bottom:6px;scrollbar-width:none}.filters::-webkit-scrollbar{display:none}
  .filters button{white-space:nowrap;padding:12px 20px}
  .chips button{padding:12px 18px}
  .tags button{font-size:16px;padding:12px 18px}
  .detail{padding:22px 20px;font-size:17px}.detail b{font-size:22px}
  .card{padding:24px 22px}.card svg{margin-bottom:32px}
  section{padding:70px 0}
  .fgrid{grid-template-columns:1fr}
}

/* ---- brands, results, testimonials ---- */
.brands{padding-bottom:90px;overflow:hidden}
.brands h2,.results h2{font-size:clamp(34px,5vw,60px);max-width:18ch}
.brands .sub{color:var(--muted);max-width:56ch;margin:18px 0 48px}
.row{display:flex;width:max-content;margin-bottom:16px;animation:slide 55s linear infinite}
.row.rev{animation-direction:reverse;animation-duration:70s}
.rows:hover .row{animation-play-state:paused}
.tile{flex:none;display:flex;align-items:center;gap:14px;margin-right:16px;padding:18px 28px 18px 18px;border-radius:999px;background:var(--card);border:1px solid var(--line);font:700 20px "Bricolage Grotesque",sans-serif;white-space:nowrap;transition:transform .25s,border-color .25s}
.tile:hover{transform:translateY(-4px);border-color:var(--rose)}
.results{background:var(--ink);color:#fff}
.rtop{display:flex;align-items:flex-end;gap:36px;flex-wrap:wrap;margin-bottom:48px}
.big{font:800 clamp(80px,16vw,190px)/.9 "Bricolage Grotesque",sans-serif;letter-spacing:-.04em;color:var(--gold)}
.rgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:96px}
.rgrid div{padding:26px 22px;border-radius:20px;background:var(--ink2);border-top:3px solid var(--rose);transition:transform .25s}
.rgrid div:hover{transform:translateY(-5px)}
.rgrid h3{font-size:21px;margin-bottom:8px}.rgrid p{margin:0;font-size:15px;color:#cfc3e3;line-height:1.55}
.slider{overflow:hidden;border-radius:28px;background:var(--ink2);touch-action:pan-y}
.strack{display:flex;transition:transform .7s cubic-bezier(.2,.7,.2,1)}
.slide{flex:0 0 100%;margin:0;padding:clamp(30px,6vw,72px)}
.slide p{font:600 clamp(22px,3.2vw,36px)/1.25 "Bricolage Grotesque",sans-serif;margin:0 0 24px;max-width:30ch;letter-spacing:-.01em}
.slide cite{font-style:normal;color:var(--gold);font-weight:500}
.sctl{display:flex;align-items:center;gap:10px;margin-top:20px}
.sctl button{width:46px;height:46px;border-radius:50%;border:1px solid rgba(255,255,255,.3);background:transparent;color:#fff;font-size:20px;cursor:pointer;transition:background .2s}
.sctl button:hover{background:rgba(255,255,255,.12)}
.sctl .dots{display:flex;gap:8px;margin-left:12px}
.sctl .dots b{width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.3);cursor:pointer;transition:all .3s}
.sctl .dots b.on{width:30px;border-radius:6px;background:var(--gold)}
.cinfo{position:relative;z-index:1;margin-top:30px;display:grid;gap:6px}
.cinfo a{font:600 clamp(18px,2.4vw,26px) "Bricolage Grotesque",sans-serif;text-decoration:none;color:var(--gold);overflow-wrap:anywhere}
.cinfo a:hover{text-decoration:underline}
@media(max-width:960px){.rgrid{grid-template-columns:repeat(2,1fr);margin-bottom:64px}}
@media(max-width:520px){.rgrid{grid-template-columns:1fr}.tile{font-size:17px;padding:14px 22px 14px 14px}.sctl button{width:48px;height:48px}.brands .sub{margin-bottom:32px}}
.tile.logo{padding:16px 28px;height:112px;border-radius:20px;justify-content:center;border:1px solid var(--line)}
.tile.logo img{height:80px;width:auto;max-width:200px;object-fit:contain;display:block}
.tile.logo img.rd{border-radius:50%}
.tile.more{height:112px;padding:0 36px;border-radius:20px;font-size:22px;background:var(--ink);color:#fff;border-color:var(--ink)}
@media(max-width:520px){.tile.logo,.tile.more{height:92px;padding:12px 20px}.tile.logo img{height:64px;max-width:150px}}

/* ---- polish ---- */
::selection{background:var(--gold);color:var(--ink)}
h1,h2,h3{text-wrap:balance}p{text-wrap:pretty}
img{max-width:100%}
.hero .trust{display:flex;align-items:center;gap:14px;margin-top:40px;max-width:52ch;font-size:15px;line-height:1.5;color:#cfc3e3;animation:rise .9s .45s both}
.hero .trust::before{content:"";flex:none;width:36px;height:2px;background:var(--gold)}
.fbase .top,footer .top{color:#cfc3e3;text-decoration:none}.fbase .top:hover{color:#fff}
.btn:active,.filters button:active,.chips button:active,.tags button:active{transform:scale(.97)}
.tile.logo{box-shadow:0 1px 2px rgba(26,15,46,.06)}
.tile.logo:hover{box-shadow:0 12px 28px rgba(26,15,46,.16)}
.brands .rows{mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.slider{box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
.slide cite::before{content:"";display:inline-block;width:28px;height:2px;margin-right:12px;vertical-align:middle;background:var(--gold)}
.contact input:focus,.contact textarea:focus{border-color:var(--gold);background:rgba(255,255,255,.12);outline:none;box-shadow:0 0 0 3px rgba(243,182,64,.3)}
@media(max-width:520px){.hero .trust{font-size:14px;margin-top:30px}}
@media(prefers-reduced-motion:reduce){
  .brands .rows{overflow-x:auto;mask-image:none;-webkit-mask-image:none}
  .js .rv{opacity:1;transform:none}
  .blob,.mark{animation:none}
}

.slide .who2{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
.slide .lg2{display:grid;place-items:center;min-width:120px;height:120px;padding:14px 22px;border-radius:22px}
.slide .lg2 img{height:90px;width:auto;max-width:210px;object-fit:contain;display:block}.slide .lg2 img.rd{border-radius:50%}
.slide cite{display:block;font:800 clamp(26px,4vw,46px)/1.1 "Bricolage Grotesque",sans-serif;color:#fff;letter-spacing:-.02em}
.slide cite::before{display:none}
.slide .who2 span:not(.lg2){display:block;margin-top:8px;color:var(--gold);font-weight:500;font-size:18px}
.slide .who2+p{margin-top:28px}
@media(max-width:520px){.slide .lg2{min-width:96px;height:96px}.slide .lg2 img{height:70px;max-width:150px}.slide{padding:26px 22px}}
.slide .who2+p{font-size:clamp(19px,2.3vw,27px);line-height:1.4;max-width:46ch;font-weight:600}
</style>
</head>
<body>
<div class="progress" id="pg"></div>

<header class="nav"><div class="wrap">
